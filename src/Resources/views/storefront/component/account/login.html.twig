{#
    Shopware resolves a plugin's Storefront template override by matching
    this file's own path (relative to Resources/views/storefront/) against
    the target template's namespaced path - `sw_extends` alone is not
    enough, the file has to live at the exact same relative path as the
    template it overrides for the bundle-chain resolution to link them at
    all. This file previously lived at
    page/account/login/index.html.twig, extending a page template that
    doesn't exist in the real theme (there is no standalone login "page" -
    the login form is a reusable COMPONENT embedded wherever needed, e.g.
    the account page and the checkout guest/login step). Confirmed against
    the exact v6.7.14.0 source
    (storefront/component/account/login.html.twig): moved here, and its
    outermost form block is `component_account_login_form`, not
    `page_account_login_form`.
#}
{% sw_extends '@Storefront/storefront/component/account/login.html.twig' %}

{% block component_account_login_form %}
    {% set sw6oidcSsoProviders = sw6oidc_storefront_sso_providers(context) %}
    {% set sw6oidcPasskeyAvailable = sw6oidc_storefront_passkey_available(context) %}

    {#
        disable_non_oidc_customer_login: don't render the email/password
        form — but only when this page actually offers another way in.
        Cosmetic only — PasswordLoginGuardLoginRoute rejects password logins
        (Storefront and Store API) server-side either way.
    #}
    {% if sw6oidc_storefront_password_login_disabled(context) and (sw6oidcSsoProviders is not empty or sw6oidcPasskeyAvailable) %}
        {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
            type: 'info',
            content: 'sw6oidc.login.passwordLoginDisabled'|trans|sw_sanitize
        } %}
    {% else %}
        {{ parent() }}
    {% endif %}

    {% if sw6oidcSsoProviders is not empty or sw6oidcPasskeyAvailable %}
        {#
            Bootstrap 5 (this theme ships 5.3.8) removed `.btn-block` -
            it silently does nothing here, so both buttons fell back to
            inline-block sizing and sat side by side instead of stacking.
            `.d-grid` + `.gap-2` on the wrapper is the Bootstrap-5-idiomatic
            replacement: each child becomes a full-width grid row with
            consistent spacing, no per-button width/margin classes needed.
        #}
        <div class="sw6oidc-login-actions d-grid gap-2 mt-3">
            {#
                One button per visible provider (each already carries its own
                resolved label - the provider's displayName, or the generic
                translated fallback if that's blank) rather than a single
                hardcoded "Login with SSO" - a shop with more than one active
                provider otherwise has no way to tell them apart here.
            #}
            {% for sw6oidcSsoProvider in sw6oidcSsoProviders %}
                {#
                    The same redirectTo/redirectParameters core's own login form
                    submits (route name + parameters, e.g. the checkout), resolved
                    and validated server-side by RelayStateValidator.
                #}
                <a href="{{ path('frontend.sw6oidc.login', {
                    redirectTo: redirectTo ?? 'frontend.account.home.page',
                    redirectParameters: redirectParameters is defined and redirectParameters is iterable ? redirectParameters|json_encode : (redirectParameters ?? null),
                    providerId: sw6oidcSsoProvider.id
                }) }}"
                   rel="nofollow"
                   class="btn btn-secondary">
                    {{ sw6oidcSsoProvider.label }}
                </a>
            {% endfor %}

            {% if sw6oidcPasskeyAvailable %}
                <button type="button"
                        class="btn btn-secondary"
                        data-sw6oidc-passkey-login="true"
                        data-sw6oidc-options-url="{{ path('frontend.sw6oidc.passkey.login-options') }}"
                        data-sw6oidc-verify-url="{{ path('frontend.sw6oidc.passkey.login-verify') }}"
                        data-sw6oidc-error-target="sw6oidc-passkey-login-error"
                        data-sw6oidc-error-text="{{ 'sw6oidc.passkey.loginError'|trans|striptags }}"
                        data-sw6oidc-no-support-text="{{ 'sw6oidc.passkey.noSupport'|trans|striptags }}">
                    {{ 'sw6oidc.passkey.button'|trans|sw_sanitize }}
                </button>
            {% endif %}
        </div>

        {% if sw6oidcPasskeyAvailable %}
            <div id="sw6oidc-passkey-login-error" class="alert alert-danger mt-2" role="alert" hidden></div>
        {% endif %}
    {% endif %}
{% endblock %}
