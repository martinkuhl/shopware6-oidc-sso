{#
    Only shown when Shopware's own native SSO is active (core routes users to
    this page then). A narrow block extension instead of a copy of core's
    content block, so core changes to the rest of the page keep applying.
#}
{% block sw_settings_sso_user_detail_content_details %}
{% parent %}

{% block sw6oidc_sso_user_detail_provider %}
<div
    v-if="userId && user && !user.isNew()"
    class="sw6oidc-user-detail-provider"
>
    <span class="sw6oidc-user-detail-provider__label">{{ $t('sw6oidc.userProvider.label') }}:</span>
    <sw6oidc-user-provider-info
        user-type="admin"
        :user-id="userId"
    />
</div>
{% endblock %}
{% endblock %}
