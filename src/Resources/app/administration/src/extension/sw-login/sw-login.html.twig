{#
    While disable_non_oidc_admin_login is on and another way in is offered,
    only the username field, the password field and the login button are
    hidden (R3-F10): core's "Keep me logged in" checkbox sits next to the
    button inside sw_login_login_submit and has to stay, because the SSO and
    passkey logins honour it (rememberMe). Cosmetic only, the server refuses
    password logins either way.
#}
{% block sw_login_login_user_field %}
<p
    v-if="sw6oidcPasswordLoginDisabled"
    class="sw6oidc-login-actions__notice"
    role="status"
>
    {{ sw6oidcText('passwordLoginDisabled') }}
</p>
<template v-else>
{% parent %}
</template>
{% endblock %}

{% block sw_login_login_password_field %}
<template v-if="!sw6oidcPasswordLoginDisabled">
{% parent %}
</template>
{% endblock %}

{% block sw_login_login_submit_button %}
<template v-if="!sw6oidcPasswordLoginDisabled">
{% parent %}
</template>
{% endblock %}

{#
    The SSO and passkey buttons are rendered as siblings after core's form:
    they are not part of the password form, and must also show when core's
    own SSO hides the default login (loginConfig.useDefault = false).
#}
{% block sw_login_login %}
{% parent %}

<div
    v-if="sw6oidcSsoProviders.length || sw6oidcPasskeyAvailable"
    class="sw6oidc-login-actions"
>
    <mt-button
        v-for="provider in sw6oidcSsoProviders"
        :key="provider.id"
        class="sw6oidc-login-actions__sso-button"
        variant="primary"
        size="default"
        :block="true"
        type="button"
        @click="sw6oidcStartLogin(provider.id)"
    >
        {{ sw6oidcSsoButtonLabel(provider) }}
    </mt-button>

    <mt-button
        v-if="sw6oidcPasskeyAvailable"
        class="sw6oidc-login-actions__passkey-button"
        variant="primary"
        size="default"
        :block="true"
        type="button"
        :disabled="sw6oidcPasskeyPending"
        :is-loading="sw6oidcPasskeyPending"
        @click="sw6oidcStartPasskeyLogin"
    >
        {{ sw6oidcText('passkeyButton') }}
    </mt-button>
</div>

{# Outside the buttons' v-if: a denial must show even when no button is visible (F-M13). #}
<div
    v-if="sw6oidcExchangeError"
    class="sw6oidc-login-actions__error"
    role="alert"
>
    {{ sw6oidcErrorMessage }}
</div>

<div
    v-if="sw6oidcPasskeyError"
    class="sw6oidc-login-actions__error"
    role="alert"
>
    {{ sw6oidcText('passkeyError') }}
</div>
{% endblock %}
