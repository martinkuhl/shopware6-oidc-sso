{% block sw_profile_index_general_information %}
{% parent %}

{% block sw6oidc_profile_index_general_provider %}
<mt-card
    v-if="user && user.id"
    class="sw6oidc-profile-provider"
    position-identifier="sw6oidc-profile-provider"
    :title="$t('sw6oidc.userProvider.profileCardTitle')"
>
    <div class="sw6oidc-user-detail-provider">
        <span class="sw6oidc-user-detail-provider__label">{{ $t('sw6oidc.userProvider.label') }}:</span>
        <sw6oidc-user-provider-info
            user-type="admin"
            :user-id="user.id"
            :allow-unlink="false"
        />
    </div>

    <sw6oidc-connect-sso :user-id="user.id" />
</mt-card>
{% endblock %}
{% endblock %}
