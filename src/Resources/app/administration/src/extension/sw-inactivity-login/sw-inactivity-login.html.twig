{#
    Only one block exists in the real v6.7.14.0 source
    (module/sw-inactivity-login/page/index/sw-inactivity-login.html.twig) -
    sw_inactivity_login wraps the entire component including the <sw-modal>
    itself, so there's no finer block to append our button to without it
    rendering outside the modal card. Reproducing the full markup here
    (rather than {% parent %} + sibling markup, as sw-login-login's override
    does) is the only way to place our passkey button actually inside the
    dialog.

    Re-sync checklist for every Shopware core upgrade (F-M2):
      1. diff core's module/sw-inactivity-login/page/index/sw-inactivity-login.html.twig
         against this copy (everything outside the sw6oidc-* markup);
      2. port changed attributes/events of the password field and buttons;
      3. check the inactivity component's methods used here still exist
         (loginService, lastKnownUser, handleLoginSuccess / forwardLogin);
      4. update the version in the first line of this comment.
#}
{% block sw_inactivity_login %}
<div class="sw-inactivity-login">

    <sw-modal
        v-if="lastKnownUser"
        class="sw-inactivity-login__modal"
        :title="$t('global.sw-inactivity-login.modal.title')"
        :closable="false"
    >
        <template v-if="!sw6oidcPasswordLoginDisabled">
            <mt-password-field
                v-model="password"
                v-autofocus
                :label="$t('sw-login.index.labelPassword')"
                :disabled="isLoading"
                :error="passwordError"
                @keydown.enter="loginUserWithPassword"
            />

            <mt-checkbox
                v-model:checked="rememberMe"
                :label="$t('sw-login.index.labelKeepLoggedIn')"
            />
        </template>

        {# One button per visible admin-scoped provider, as on the main login screen. #}
        <mt-button
            v-for="provider in sw6oidcSsoProviders"
            :key="provider.id"
            class="sw6oidc-inactivity-login__sso-button"
            variant="secondary"
            size="default"
            :block="true"
            type="button"
            @click="sw6oidcStartSsoLogin(provider.id)"
        >
            {{ sw6oidcSsoButtonLabel(provider) }}
        </mt-button>

        <mt-button
            v-if="sw6oidcPasskeyAvailable"
            class="sw6oidc-inactivity-login__passkey-button"
            variant="secondary"
            size="default"
            :block="true"
            type="button"
            :disabled="sw6oidcPasskeyPending"
            :is-loading="sw6oidcPasskeyPending"
            @click="sw6oidcStartPasskeyLogin"
        >
            {{ $t('sw-login.sw6oidc.login.passkeyButton') }}
        </mt-button>

        <div
            v-if="sw6oidcPasskeyError"
            class="sw6oidc-inactivity-login__error"
            role="alert"
        >
            {{ sw6oidcPasskeyError === 'different_user'
                ? $t('sw-login.sw6oidc.login.passkeyDifferentUser')
                : $t('sw-login.sw6oidc.login.passkeyError') }}
        </div>

        <template #modal-footer>
            <a
                role="link"
                tabindex="0"
                @click="onBackToLogin"
                @keydown.enter="onBackToLogin"
            >
                {{ $t('global.sw-inactivity-login.modal.actions.backToLogin') }}
            </a>

            <mt-button
                v-if="!sw6oidcPasswordLoginDisabled"
                variant="primary"
                :is-loading="isLoading"
                @click="loginUserWithPassword"
            >
                {{ $t('sw-login.index.buttonLogin') }}
            </mt-button>
        </template>
    </sw-modal>
</div>
{% endblock %}
