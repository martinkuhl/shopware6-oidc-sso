{% block sw6oidc_sessions_list %}
<sw-page class="sw6oidc-sessions-list">
    {% block sw6oidc_sessions_list_smart_bar_actions %}
    <template #smart-bar-actions>
        <mt-switch
            v-model="onlyActive"
            class="sw6oidc-sessions-list__only-active"
            :label="$t('sw6oidc.sessions.onlyActive')"
        />
        <mt-button
            variant="secondary"
            :is-loading="isLoading"
            @click="getList"
        >
            {{ $t('sw6oidc.sessions.refresh') }}
        </mt-button>
    </template>
    {% endblock %}

    {% block sw6oidc_sessions_list_content %}
    <template #content>
        <mt-banner
            variant="info"
            class="sw6oidc-sessions-list__hint"
        >
            {{ $t('sw6oidc.sessions.hint') }}
        </mt-banner>
        <sw-entity-listing
            v-if="activities"
            :data-source="activities"
            :repository="activityRepository"
            :columns="columns"
            :is-loading="isLoading"
            :disable-data-fetching="true"
            :show-selection="false"
            :allow-edit="false"
            :allow-view="false"
            :allow-delete="false"
            @page-change="onPageChange"
        >
            <template #column-loggedInAt="{ item }">
                {{ formatDate(item.loggedInAt) }}
            </template>
            <template #column-userType="{ item }">
                {{ translated('userType', item.userType) }}
            </template>
            <template #column-owner="{ item }">
                {{ ownerName(item) }}
            </template>
            <template #column-loginMethod="{ item }">
                {{ translated('loginMethod', item.loginMethod) }}
            </template>
            <template #column-provider="{ item }">
                {{ providerName(item) }}
            </template>
            <template #column-loggedOutAt="{ item }">
                <mt-badge
                    v-if="sessionState(item) === 'active'"
                    variant="positive"
                >
                    {{ $t('sw6oidc.sessions.active') }}
                </mt-badge>
                <mt-badge
                    v-else-if="sessionState(item) === 'expired'"
                    variant="neutral"
                >
                    {{ $t('sw6oidc.sessions.expired') }}
                </mt-badge>
                <template v-else>
                    {{ formatDate(item.loggedOutAt) }}
                </template>
            </template>
            <template #column-logoutReason="{ item }">
                {{ translated('logoutReason', item.logoutReason) }}
            </template>
            <template #actions="{ item }">
                <sw-context-menu-item
                    variant="danger"
                    :disabled="!canForceLogout || sessionState(item) !== 'active' || forceLogoutPendingId === item.id"
                    @click="onForceLogout(item)"
                >
                    {{ $t('sw6oidc.sessions.forceLogout') }}
                </sw-context-menu-item>
            </template>
        </sw-entity-listing>

        <sw-confirm-modal
            v-if="confirmItem"
            type="yesno"
            :title="$t('sw6oidc.sessions.forceLogout')"
            :text="confirmText"
            @confirm="onConfirmForceLogout"
            @cancel="onCancelForceLogout"
            @close="onCancelForceLogout"
        />
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
