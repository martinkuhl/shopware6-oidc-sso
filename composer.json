{
    "name": "martinkuhl/shopware6-oidc-sso",
    "description": "OpenID Connect (OIDC) and Passkey (WebAuthn) single sign-on for Shopware 6 Storefront customers and Administration users.",
    "type": "shopware-platform-plugin",
    "version": "0.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Martin Kuhl"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "shopware/core": ">=6.7.0.0 <6.8.0.0",
        "shopware/storefront": ">=6.7.0.0 <6.8.0.0",
        "web-token/jwt-library": "^4.0",
        "web-auth/webauthn-lib": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2",
        "vimeo/psalm": "^6.17",
        "rector/rector": "^2.6",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "MartinKuhl\\Sw6Oidc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MartinKuhl\\Sw6Oidc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html var/coverage/html --coverage-clover var/coverage/clover.xml --coverage-text",
        "phpstan": "phpstan analyse -c phpstan.neon.dist --no-progress",
        "phpstan-tests": "phpstan analyse -c phpstan.tests.neon.dist --no-progress",
        "psalm": "psalm",
        "rector": "rector process --dry-run",
        "rector-fix": "rector process",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "ci": [
            "@cs-check",
            "@phpstan",
            "@phpstan-tests",
            "@psalm",
            "@rector",
            "@test"
        ],
        "test-integration": "\"$SHOPWARE_PROJECT_ROOT/vendor/bin/phpunit\" -c phpunit.integration.xml.dist"
    },
    "extra": {
        "shopware-plugin-class": "MartinKuhl\\Sw6Oidc\\Sw6Oidc",
        "plugin-icon": "src/Resources/config/plugin.png",
        "label": {
            "en-GB": "OIDC & Passkey SSO",
            "de-DE": "OIDC- & Passkey-Anmeldung"
        },
        "description": {
            "en-GB": "OpenID Connect and Passkey single sign-on for Storefront customers and Administration users, with JIT provisioning and group/role mapping.",
            "de-DE": "OpenID-Connect- und Passkey-Single-Sign-on fur Storefront-Kunden und Administration-Benutzer, inklusive automatischer Kontoerstellung und Gruppen-/Rollenzuordnung."
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": true
        },
        "policy": {
            "advisories": {
                "block": true
            }
        }
    }
}
